/**
 * Creaciones Yanmary - Stylesheet
 * Author: Creaciones Yanmary Team
 * Year: 2025
 */

/* ========================================
   VARIABLES Y RESET
   ======================================== */
:root {
    --primary-color: #6366f1;
    --primary-dark: #4f46e5;
    --secondary-color: #ec4899;
    --background: #f8fafc;
    --surface: #ffffff;
    --text-primary: #1e293b;
    --text-secondary: #64748b;
    --border-color: #e2e8f0;
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    --success: #10b981;
    --error: #ef4444;
    
    /* Colores de redes sociales */
    --twitter-color: #1DA1F2;
    --instagram-color: #E4405F;
    --facebook-color: #1877F2;
    --tiktok-color: #000000;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: var(--background);
    color: var(--text-primary);
    line-height: 1.6;
}
/* ========================================
   HONEYPOT - Campo invisible para bots
   ======================================== */
.honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none !important;
}

/* ========================================
   NAVBAR
   ======================================== */
nav {
    background: var(--surface);
    box-shadow: var(--shadow);
    position: sticky;
    top: 0;
    z-index: 100;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

/* ========================================
   ESTILOS DEL LOGO
   ======================================== */

.logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-color);
}

.logo-image {
    height: 50px;
    width: auto;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.logo-image:hover {
    transform: scale(1.05);
}

.logo-text {
    font-size: 1.3rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* ========================================
   CARRITO MÓVIL (solo visible en mobile)
   ======================================== */
.cart-button-mobile {
    display: none; /* Oculto por defecto en desktop */
    position: relative;
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 0.5rem;
    border-radius: 50%;
    cursor: pointer;
    width: 45px;
    height: 45px;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
    transition: transform 0.2s;
}

.cart-button-mobile:hover {
    transform: scale(1.05);
}

.cart-button-mobile .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background: var(--secondary-color);
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: bold;
    border: 2px solid white;
}

/* Carrito del menú (solo visible en desktop) */
.cart-menu-item {
    display: flex;
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-primary);
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
}

.nav-menu a {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    transition: color 0.3s;
}

.nav-menu a:hover {
    color: var(--primary-color);
}

.cart-button {
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 0.5rem 1.25rem;
    border-radius: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.3s;
}

.cart-button:hover {
    background: var(--primary-dark);
}

.cart-count {
    background: var(--secondary-color);
    color: white;
    border-radius: 50%;
    width: 1.5rem;
    height: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: bold;
}

/* ========================================
   HEADER
   ======================================== */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
}

header {
    text-align: center;
    margin-bottom: 3rem;
}

header h1 {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
}

.subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
}

/* ========================================
   PRODUCTOS
   ======================================== */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.product-card {
    background: var(--surface);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.3s, box-shadow 0.3s;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
}

.product-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.product-card h2 {
    font-size: 1.25rem;
    margin: 1rem;
    color: var(--text-primary);
}

.product-price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-color);
    margin: 0 1rem;
}

.product-description {
    color: var(--text-secondary);
    margin: 0.5rem 1rem;
    font-size: 0.9rem;
}

.add-to-cart {
    width: calc(100% - 2rem);
    margin: 1rem;
    padding: 0.75rem;
    background: var(--primary-color);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s;
}

.add-to-cart:hover {
    background: var(--primary-dark);
}

/* ========================================
   FOOTER
   ======================================== */
footer {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 3rem 0;
    margin-top: 3rem;
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
}

.footer-title {
    font-size: 1.75rem;
    margin-bottom: 2rem;
    font-weight: 600;
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
}

.social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    color: white;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: all 0.3s ease;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.social-link span {
    font-size: 1.25rem;
}

/* Colores específicos para cada red social */
.social-link.twitter {
    background: var(--twitter-color);
}

.social-link.twitter:hover {
    background: #1a91da;
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(29, 161, 242, 0.4);
}

.social-link.instagram {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
}

.social-link.instagram:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(228, 64, 95, 0.4);
}

.social-link.facebook {
    background: var(--facebook-color);
}

.social-link.facebook:hover {
    background: #166fe5;
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(24, 119, 242, 0.4);
}

.social-link.tiktok {
    background: var(--tiktok-color);
}

.social-link.tiktok:hover {
    background: #333333;
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.4);
}

.footer-text {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    line-height: 1.8;
}

/* ========================================
   MODAL DEL CARRITO Y CONTACTO
   ======================================== */
.cart-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.cart-modal.active {
    display: flex;
}

.cart-content {
    background: var(--surface);
    border-radius: 1rem;
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 2rem;
    position: relative;
}

.close-cart {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-secondary);
    transition: color 0.3s;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.close-cart:hover {
    color: var(--error);
}

.cart-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
}

/* ========================================
   ITEMS DEL CARRITO
   ======================================== */
.empty-cart {
    text-align: center;
    padding: 3rem 1rem;
}

.empty-cart-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.3;
}

.empty-cart p {
    color: var(--text-secondary);
    font-size: 1.125rem;
}

.cart-item {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--background);
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    align-items: center;
}

.cart-item-info {
    display: flex;
    gap: 1rem;
    flex: 1;
}

.cart-item-image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 0.5rem;
}

.cart-item-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.cart-item-name {
    font-weight: 600;
    color: var(--text-primary);
}

.cart-item-price {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.cart-item-quantity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.qty-btn {
    background: var(--primary-color);
    color: white;
    border: none;
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.3s;
}

.qty-btn:hover {
    background: var(--primary-dark);
}

.remove-item {
    background: var(--error);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.25rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: opacity 0.3s;
}

.remove-item:hover {
    opacity: 0.8;
}

/* ========================================
   TOTAL Y CHECKOUT
   ======================================== */
.cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    background: var(--background);
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    font-size: 1.25rem;
    font-weight: bold;
}

.total-amount {
    color: var(--primary-color);
    font-size: 1.5rem;
}

/* Botones de checkout duales */
.checkout-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.checkout-button {
    width: 100%;
    padding: 1rem;
    color: #764ba2;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.whatsapp-button {
    background: #25D366;
}

.whatsapp-button:hover {
    background: #128C7E;
}

.email-button {
    background: var(--success);
}

.email-button:hover {
    background: #059669;
}

.checkout-button:disabled {
    background: var(--text-secondary);
    cursor: not-allowed;
    opacity: 0.6;
}

/* Botón específico del formulario de contacto */
.contact-form .checkout-button {
    background: var(--primary-color);
    color: white;
    margin-top: 0.5rem;
}

.contact-form .checkout-button:hover {
    background: var(--primary-dark);
}

.contact-form .checkout-button:disabled {
    background: var(--text-secondary);
}
/*prueba*/

/* ========================================
   FORMULARIO DE CONTACTO
   ======================================== */
.contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group label {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9rem;
}

.form-group input,
.form-group textarea {
    padding: 0.75rem;
    border: 2px solid var(--border-color);
    border-radius: 0.5rem;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
}

.form-group textarea {
    resize: vertical;
    min-height: 80px;
}

/* ========================================
   NOTIFICACIÓN
   ======================================== */
.notification {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--success);
    color: white;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    box-shadow: var(--shadow-lg);
    transform: translateY(150%);
    transition: transform 0.3s ease-in-out;
    z-index: 1001;
    font-weight: 600;
}

.notification.show {
    transform: translateY(0);
}

/* ========================================
   BOTÓN FLOTANTE DE WHATSAPP
   ======================================== */
.whatsapp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
    background: #25D366;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
    z-index: 999;
    transition: all 0.3s ease;
    text-decoration: none;
    animation: pulse 2s infinite;
}

.whatsapp-float:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
}

.whatsapp-float svg {
    width: 32px;
    height: 32px;
}

.whatsapp-tooltip {
    position: absolute;
    right: 70px;
    background: white;
    color: var(--text-primary);
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    box-shadow: var(--shadow-lg);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    font-size: 0.9rem;
    font-weight: 500;
}

.whatsapp-float:hover .whatsapp-tooltip {
    opacity: 1;
}

/* Animación de pulso para el botón de WhatsApp */
@keyframes pulse {
    0% {
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
    }
    50% {
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4), 0 0 0 10px rgba(37, 211, 102, 0.1);
    }
    100% {
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
    }
}

/* ========================================
   RESPONSIVE
   ======================================== */

/* IMPORTANTE: En desktop (más de 768px) ocultamos el carrito móvil */
@media (min-width: 769px) {
    .cart-button-mobile {
        display: none !important;
    }
    
    .cart-menu-item {
        display: flex !important;
    }
}

/* En tablets y móviles (768px o menos) mostramos carrito móvil */
@media (max-width: 768px) {
    /* Mostrar carrito móvil SOLO en tablets y móviles */
    .cart-button-mobile {
        display: flex !important;
    }
    
    /* Ocultar el item de carrito del menú SOLO en tablets y móviles */
    .cart-menu-item {
        display: none !important;
    }
    
    .menu-toggle {
        display: block;
    }
    
    .nav-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--surface);
        flex-direction: column;
        padding: 1rem;
        box-shadow: var(--shadow);
        display: none;
    }
    
    .nav-menu.active {
        display: flex;
    }
    
    /* Responsive para el logo */
    .logo-image {
        height: 40px;
    }
    
    .logo-text {
        font-size: 1.1rem;
    }
    
    header h1 {
        font-size: 2rem;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
    }
    
    .cart-content {
        padding: 1.5rem;
    }
    
    .cart-item {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .cart-item-quantity {
        width: 100%;
        justify-content: center;
    }
    
    .remove-item {
        width: 100%;
    }
    
    .social-links {
        flex-direction: column;
        align-items: center;
    }
    
    .social-link {
        width: 100%;
        max-width: 280px;
        justify-content: center;
    }
    
    .notification {
        right: 1rem;
        left: 1rem;
        bottom: 1rem;
        font-size: 0.95rem;
    }
    
    /* WhatsApp button en mobile - ajustar posición */
    .whatsapp-float {
        bottom: 90px;
        width: 55px;
        height: 55px;
    }
    
    .whatsapp-float svg {
        width: 28px;
        height: 28px;
    }
    
    .whatsapp-tooltip {
        display: none;
    }
}

@media (max-width: 480px) {
    .products-grid {
        grid-template-columns: 1fr;
    }
    
    /* Logo más pequeño en móviles */
    .logo-image {
        height: 35px;
    }
    
    .logo-text {
        font-size: 1rem;
    }
    
    header h1 {
        font-size: 1.75rem;
    }
    
    .subtitle {
        font-size: 1rem;
    }
}